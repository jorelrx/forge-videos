# ============================================
# PROVIDER (escolha um)
# ============================================
# FORGE_PROVIDER=anthropic      # Padrão
# FORGE_PROVIDER=openai
# FORGE_PROVIDER=lm-studio      # Local, dispensa API key
# FORGE_PROVIDER=codex          # Assinatura ChatGPT via HTTP/OAuth próprio; uv run forge auth codex login
# FORGE_PROVIDER=claude         # Assinatura Claude via `claude -p`; rode `claude auth login` antes
# FORGE_CLAUDE_EFFORT=high      # low | medium | high | xhigh | max
# FORGE_CLAUDE_BIN=claude
# FORGE_CLAUDE_RUNS_DIR=        # padrão: %TEMP%/forge-claude (fora do repo de propósito)
# Revisor de outro provider (vazio = o mesmo do escritor).
# FORGE_REVIEW_PROVIDER=claude
# FORGE_REVIEW_MODEL=           # vazio = padrão do provider revisor
# FORGE_LM_STUDIO_BASE_URL=http://localhost:1234/v1

# ============================================
# API KEY
# ============================================
# FORGE_API_KEY vale para o provider ativo e vence as específicas abaixo.
# FORGE_API_KEY=

# API key Anthropic (ou use ANTHROPIC_API_KEY)
FORGE_ANTHROPIC_API_KEY=

# API key OpenAI (ou use OPENAI_API_KEY)
# FORGE_OPENAI_API_KEY=

# ============================================
# MODELO
# ============================================
# Sem FORGE_MODEL, cada provider usa seu default:
#   anthropic -> claude-opus-4-8
#   openai    -> gpt-5-nano
#   lm-studio -> google/gemma-4-e4b
#   codex     -> gpt-6.1-sol
# Definido, sobrepõe o default de qualquer provider.
# FORGE_MODEL=
# FORGE_EFFORT=high              # Só anthropic

# Codex nativo: Forge faz HTTP/OAuth diretamente, sem Hermes/CLI/proxy.
# Login próprio: uv run forge auth codex login (tokens fora do repo).
# FORGE_CODEX_TRANSPORT=native
# FORGE_CODEX_AUTH_FILE=C:/Users/SEU_USUARIO/.forge/codex/auth.json
# FORGE_CODEX_IMAGE_MODEL=gpt-image-2
# FORGE_CODEX_IMAGE_QUALITY=medium
# Compatibilidade opcional: FORGE_CODEX_TRANSPORT=cli usa opções abaixo.
# Não coloque tokens no .env.
# FORGE_CODEX_BIN=codex
# FORGE_CODEX_MODEL=gpt-6-astra
# FORGE_CODEX_EFFORT=low
# FORGE_CODEX_RUNS_DIR=output/codex
# FORGE_IMAGE_PROVIDER=codex     # comfyui (default) ou codex
# FORGE_IMAGE_TIMEOUT=1800

# Publicação no YouTube: cliente OAuth desktop do Google Cloud + login pela aba
# Publicação (ou uv run forge auth youtube login). Tokens fora do repo; nunca no .env.
# FORGE_YOUTUBE_CLIENT_SECRETS=C:/Users/SEU_USUARIO/.forge/youtube/client_secret.json
# FORGE_YOUTUBE_CANAIS_DIR=C:/Users/SEU_USUARIO/.forge/youtube/canais   # um token por canal
# FORGE_YOUTUBE_CATEGORIA=27     # 27 = Educação
# FORGE_YOUTUBE_SINTETICO=true   # declara conteúdo sintético (voz e imagens geradas)

# ============================================
# CONFIGURAÇÕES DE LOGGING
# ============================================
# FORGE_LOG_LEVEL=INFO           # Verbose: DEBUG, Padrão: INFO, Silencioso: WARNING ou ERROR
# FORGE_MAX_REVIEW_ROUNDS=8      # Limite de iterações de review (também usado em logs)

# ============================================
# FORGE STUDIO (operação local)
# ============================================
# O launcher (scripts/start-studio.ps1) sobe API, worker e web. Ele lê estas
# variáveis do .env; credenciais NÃO entram no launcher — nenhuma delas é
# registrada em data/studio/logs nem no relatório do doctor.

# Fonte de verdade operacional e raiz dos artefatos por run.
# FORGE_STUDIO_DB_PATH=data/forge.db
# FORGE_STUDIO_RUNS_DIR=output/runs

# API local em 127.0.0.1 (web correspondente em 127.0.0.1:3100).
# FORGE_STUDIO_API_PORT=8765

# Intervalo de polling do forge-worker quando ocioso; precisa ser > 0.
# FORGE_STUDIO_WORKER_POLL_SECONDS=1.0

# Lease do worker: heartbeat precisa ser estritamente menor que o lease.
# FORGE_WORKER_LEASE_SECONDS=15
# FORGE_WORKER_HEARTBEAT_SECONDS=5

# ============================================
# TTS e ComfyUI (paths locais; o doctor valida)
# ============================================
# IMPORTANTE: escreva paths com barras normais (`C:/dev/...`). O parser do
# .env trata `\a`, `\b` e `\v` como sequências de escape: `C:\dev\...` chega
# corrompido como `C:<BEL>ev\...` e o path morre sem erro visível.
#
# Diretório base do audio-generate. Os três paths abaixo derivam dele quando
# não informados explicitamente, seguindo o layout do próprio tool:
#   servidor -> <dir>/runtime/bin/audiocpp_server.exe
#   modelo  -> <dir>/runtime/models/higgs-audio-v3-tts-4b-q8_0.gguf
#   voz     -> <dir>/ref.wav
# FORGE_AUDIO_GENERATE_DIR=C:/dev/audio-generate
# FORGE_TTS_SERVER_BINARY=C:/dev/audio-generate/runtime/bin/audiocpp_server.exe
# O servidor carrega o modelo uma vez por etapa de áudio. Trecho que esgota as
# sementes na GPU vai para um segundo servidor na CPU, em paralelo.
# FORGE_TTS_CPU_THREADS=12
# FORGE_TTS_SERVER_START_TIMEOUT=120
# FORGE_TTS_MODEL=C:/dev/audio-generate/runtime/models/higgs-audio-v3-tts-4b-q8_0.gguf
# FORGE_TTS_VOICE_REFERENCE=C:/dev/audio-generate/ref.wav
# Transcrição literal do áudio de referência; melhora a fidelidade da voz.
# FORGE_TTS_REFERENCE_TEXT=A vida moderna é um exercício de divisão que não começamos deliberadamente.
# FORGE_TTS_BACKEND=vulkan

# ComfyUI local e diretórios de imagem/LoRA.
# FORGE_COMFY_URL=http://127.0.0.1:8188
# O pipeline precisa subir o ComfyUI porque o broker o encerra antes do TTS
# (o processo segura o heap Vulkan). Aponte o diretório onde está `main.py`;
# o python do venv é derivado dele (FORGE_COMFY_PYTHON sobrepõe).
# FORGE_COMFY_DIR=C:/Program Files/StabilityMatrix-win-x64/Data/Packages/ComfyUI
# FORGE_COMFY_PYTHON=C:/Program Files/StabilityMatrix-win-x64/Data/Packages/ComfyUI/venv/Scripts/python.exe
# FORGE_COMFY_OUTPUT_DIR=data/comfy/output
# FORGE_COMFY_AUTO_START=true
# FORGE_COMFY_BOOT_TIMEOUT=180
# FORGE_COMFY_ARGS=--directml --lowvram --reserve-vram 0.5
# FORGE_IMAGE_LIBRARY_DIR=library/images
# FORGE_LORA_DIR=C:/Program Files/StabilityMatrix-win-x64/Data/Models/Lora

# ============================================
# CALIBRAÇÃO DA INFERÊNCIA LOCAL
# ============================================
# O `gemma-4-e4b` gasta ~15 min por passada completa do roteiro, e o teto de
# 3600 s da etapa não cobre o laço de review: a run morre em
# `subprocess_timeout` no meio. Os dois botões são estes — o multiplicador
# escala TODAS as etapas, o teto de rounds encurta o laço.
# FORGE_LOCAL_STAGE_TIMEOUT_MULTIPLIER=2
# FORGE_MAX_REVIEW_ROUNDS=4

# ============================================
# TESTES DE INTEGRAÇÃO (opt-in, nunca na suíte padrão)
# ============================================
# `uv run pytest` mantém `-m not integration`. Os testes reais exigem a flag
# e falam com research, LM Studio, TTS, ComfyUI e FFmpeg da máquina.
# FORGE_RUN_INTEGRATION=1
# O teste ponta a ponta completo exige, além da anterior, esta flag.
# FORGE_RUN_STUDIO_E2E=1

# ---- Canal Conquistas Cósmicas: embalagem de publicação ----
# Linha na descrição do vídeo avisando que narração e imagens são geradas por
# IA. Ligada por padrão.
# FORGE_AVISO_IA=true

# Acabamento do vídeo. Coloque faixas licenciadas em library/trilhas/ (ou numa
# subpasta com o nome do eixo); um <faixa>.txt ao lado vira o crédito na
# descrição. Pasta vazia: vídeo sai sem trilha.
# FORGE_TRILHAS_DIR=library/trilhas
# FORGE_TRILHA_VOLUME_DB=-20
# FORGE_CROSSFADE_SEGUNDOS=0.6
# FORGE_FONTE_VIDEO=Georgia
# FORGE_FONTE_THUMBNAIL=C:\Windows\Fonts\georgiab.ttf
